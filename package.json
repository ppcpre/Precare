{
  "name": "precare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && node scripts/check-authz.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply precare-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply precare-db --remote",
    "deploy:dev": "opennextjs-cloudflare build && opennextjs-cloudflare deploy -- --env dev",
    "db:migrate:dev": "wrangler d1 migrations apply precare-dev-db --remote --env dev",
    "db:seed:local": "wrangler d1 execute precare-db --local --file=scripts/seed-dev.sql",
    "db:seed:dev": "wrangler d1 execute precare-dev-db --remote --env dev --file=scripts/seed-dev.sql",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "go-live": "node scripts/go-live-check.mjs"
  },
  "dependencies": {
    "better-auth": "^1.7.1",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "lucide-react": "^1.34.0",
    "next": "16.3.2",
    "next-safe-action": "^8.6.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
